{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "schedule:weekly", ":timezone(Asia/Seoul)"],
	"ignorePaths": ["**/node_modules/**"],
	"packageRules": [
		{
			"matchUpdateTypes": ["minor", "patch", "digest"],
			"groupName": "non-major",
			"automerge": true,
			"automergeType": "branch"
		}
	]
}
